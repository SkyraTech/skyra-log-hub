{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditHistoryPage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "nextCursor",
    "order",
    "pageSize"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "public-audit-event.schema.json"
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048,
      "pattern": "^[-_A-Za-z0-9]+\\.[-_A-Za-z0-9]{43}$"
    },
    "order": {
      "const": "timestamp_desc_id_desc"
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "watermark": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "description": "Admin scope assertion; BFF omits this internal transport field."
    }
  }
}

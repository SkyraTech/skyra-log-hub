{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditReadAccess",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canRead",
    "actions"
  ],
  "properties": {
    "canRead": {
      "const": true
    },
    "actions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "label"
        ],
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "label": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    }
  }
}

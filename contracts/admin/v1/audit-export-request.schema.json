{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditMatchingExportRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "filters"
  ],
  "properties": {
    "format": {
      "enum": [
        "json",
        "csv"
      ]
    },
    "filters": {
      "$ref": "#/$defs/filters"
    }
  },
  "$defs": {
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "actorId": {
          "type": "string",
          "format": "uuid"
        },
        "resourceType": {
          "enum": [
            "saved_search",
            "tenant",
            "membership",
            "project",
            "credential",
            "quota",
            "retention"
          ]
        },
        "resourceId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]{1,64}$"
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}

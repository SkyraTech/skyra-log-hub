{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.skyra-tech.com/schemas/admin/v1/project-request.schema.json",
  "title": "ProjectCreateUpdateRequestV1",
  "description": "Payload for provisioning or modifying an observability project.",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
      "description": "Canonical kebab-case project identifier (e.g. billing-gateway). Immutable once provisioned."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255,
      "description": "Human-readable project title."
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "SUSPENDED", "ARCHIVED"],
      "description": "Project operational status."
    }
  }
}

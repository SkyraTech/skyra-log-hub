{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicAdministrativeAuditEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "timestamp",
    "action",
    "actionLabel",
    "actorId",
    "actorLabel",
    "resourceType",
    "resourceId",
    "summary",
    "correlationId",
    "changes",
    "metadataOmitted"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "actionLabel": {
      "type": "string",
      "maxLength": 128
    },
    "actorId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "actorLabel": {
      "type": "string",
      "maxLength": 125
    },
    "resourceType": {
      "enum": [
        "tenant",
        "membership",
        "project",
        "credential",
        "quota",
        "retention",
        "unknown"
      ]
    },
    "resourceId": {
      "type": "string",
      "maxLength": 64
    },
    "summary": {
      "type": "string",
      "maxLength": 512
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9-]{1,64}$"
    },
    "changes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "label",
          "before",
          "after",
          "beforeAvailable",
          "afterAvailable"
        ],
        "properties": {
          "field": {
            "enum": [
              "name",
              "status",
              "roles",
              "id",
              "isRevoked",
              "expiresAt",
              "rotatedFromId",
              "enabled",
              "dailyEvents",
              "dailyBytes",
              "retentionDays"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 64
          },
          "before": {
            "type": [
              "string",
              "boolean",
              "null"
            ],
            "maxLength": 255
          },
          "after": {
            "type": [
              "string",
              "boolean",
              "null"
            ],
            "maxLength": 255
          },
          "beforeAvailable": {
            "type": "boolean"
          },
          "afterAvailable": {
            "type": "boolean"
          }
        }
      }
    },
    "metadataOmitted": {
      "type": "boolean"
    },
    "actorDisplayName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80,
      "description": "Current tenant-scoped safe member display name, not an immutable historical name."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DailyQuotaPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "dailyEvents",
    "dailyBytes",
    "version",
    "canManage"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "dailyEvents": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]{0,15})$",
      "description": "Decimal integer at most 9007199254740991, or null for unlimited. Server validates the exact upper bound."
    },
    "dailyBytes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]{0,15})$",
      "description": "Decimal integer at most 9007199254740991, or null for unlimited. Server validates the exact upper bound."
    },
    "version": {
      "type": "string",
      "pattern": "^\"q[0-9]{1,16}\"$"
    },
    "canManage": {
      "type": "boolean"
    }
  }
}

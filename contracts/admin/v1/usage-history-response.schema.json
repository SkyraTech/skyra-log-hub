{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicDailyUsageHistory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "projectName",
    "start",
    "end",
    "days",
    "policy",
    "source",
    "timeBasis",
    "historicalPolicy",
    "policyBasis",
    "measuredAt",
    "limits",
    "policyNote"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "maxLength": 64
    },
    "projectName": {
      "type": "string",
      "maxLength": 255
    },
    "start": {
      "type": "string",
      "format": "date"
    },
    "end": {
      "type": "string",
      "format": "date"
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 90,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "period",
          "events",
          "bytes",
          "completeness",
          "historicalQuotaExceeded",
          "recordedWindow",
          "updatedAt"
        ],
        "properties": {
          "period": {
            "type": "string",
            "format": "date"
          },
          "events": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accepted",
              "reserved",
              "historicalLimit",
              "utilization",
              "currentPolicyReference"
            ],
            "properties": {
              "accepted": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,15})$"
              },
              "reserved": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,15})$"
              },
              "historicalLimit": {
                "type": "null"
              },
              "utilization": {
                "type": "null"
              },
              "currentPolicyReference": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "utilization",
                  "capacity"
                ],
                "properties": {
                  "limit": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^(0|[1-9][0-9]{0,15})$"
                  },
                  "utilization": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "capacity": {
                    "enum": [
                      "UNLIMITED",
                      "ZERO_LIMIT",
                      "EXHAUSTED",
                      "AVAILABLE"
                    ]
                  }
                }
              }
            }
          },
          "bytes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accepted",
              "reserved",
              "historicalLimit",
              "utilization",
              "currentPolicyReference"
            ],
            "properties": {
              "accepted": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,15})$"
              },
              "reserved": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,15})$"
              },
              "historicalLimit": {
                "type": "null"
              },
              "utilization": {
                "type": "null"
              },
              "currentPolicyReference": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "utilization",
                  "capacity"
                ],
                "properties": {
                  "limit": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^(0|[1-9][0-9]{0,15})$"
                  },
                  "utilization": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "capacity": {
                    "enum": [
                      "UNLIMITED",
                      "ZERO_LIMIT",
                      "EXHAUSTED",
                      "AVAILABLE"
                    ]
                  }
                }
              }
            }
          },
          "completeness": {
            "enum": [
              "COMPLETE",
              "RECONCILING"
            ]
          },
          "historicalQuotaExceeded": {
            "type": "null"
          },
          "recordedWindow": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "policy": {
      "$ref": "daily-quota-response.schema.json"
    },
    "source": {
      "const": "AUTHORITATIVE_ADMISSION_WINDOWS"
    },
    "timeBasis": {
      "const": "SERVER_UTC_ADMISSION_DAY"
    },
    "historicalPolicy": {
      "const": "UNAVAILABLE"
    },
    "policyBasis": {
      "const": "CURRENT_POLICY_REFERENCE"
    },
    "measuredAt": {
      "type": "string",
      "format": "date-time"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDays"
      ],
      "properties": {
        "maxDays": {
          "const": 90
        }
      }
    },
    "policyNote": {
      "type": "string",
      "maxLength": 512
    }
  }
}

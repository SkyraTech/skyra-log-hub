{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.skyra-tech.com/schemas/admin/v1/credential-response.schema.json",
  "title": "CredentialMetadataResponseV1",
  "description": "Safe metadata representation of an ingestion credential. NEVER contains raw token secret.",
  "type": "object",
  "required": ["id", "tenantId", "keyPrefix", "description", "allowedProjects", "allowedEnvironments", "rateLimitPerMin", "createdAt", "expiresAt", "isRevoked"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "keyPrefix": {
      "type": "string",
      "description": "Visible token prefix for identification (e.g. skyra_live_7c9e6...)."
    },
    "description": {
      "type": "string"
    },
    "allowedProjects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowedEnvironments": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rateLimitPerMin": {
      "type": "integer"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "isRevoked": {
      "type": "boolean"
    },
    "lastUsedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}

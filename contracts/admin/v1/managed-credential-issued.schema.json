{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManagedCredentialIssuedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenantId",
    "projectId",
    "createdBy",
    "keyPrefix",
    "description",
    "allowedProjects",
    "allowedEnvironments",
    "rateLimitPerMin",
    "createdAt",
    "expiresAt",
    "isRevoked",
    "revokedAt",
    "rotatedFromId",
    "replacementId",
    "issuanceRequestId",
    "status",
    "version",
    "actions",
    "updatedAt",
    "rawToken"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string"
    },
    "createdBy": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "keyPrefix": {
      "type": "string",
      "description": "New managed credentials use the constant skyra_live_; no random secret characters."
    },
    "description": {
      "type": "string"
    },
    "allowedProjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string"
      }
    },
    "allowedEnvironments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rateLimitPerMin": {
      "type": "integer"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "isRevoked": {
      "type": "boolean"
    },
    "revokedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "rotatedFromId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "replacementId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "issuanceRequestId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\"c[0-9a-f-]{36}:[0-9]{1,19}\"$"
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rotate",
        "revoke"
      ],
      "properties": {
        "rotate": {
          "type": "boolean"
        },
        "revoke": {
          "type": "boolean"
        }
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rawToken": {
      "type": "string",
      "pattern": "^skyra_live_[a-f0-9]{64}$",
      "description": "Returned only on successful issuance; never retrievable again"
    }
  }
}

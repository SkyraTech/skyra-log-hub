{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.skyra-tech.com/schemas/admin/v1/credential-created-response.schema.json",
  "title": "CredentialCreatedResponseV1",
  "description": "Response returned EXACTLY ONCE upon credential creation or rotation containing the raw bearer secret.",
  "type": "object",
  "required": ["id", "tenantId", "keyPrefix", "rawToken", "description", "allowedProjects", "allowedEnvironments", "rateLimitPerMin", "createdAt", "expiresAt", "isRevoked"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "keyPrefix": {
      "type": "string"
    },
    "rawToken": {
      "type": "string",
      "pattern": "^skyra_live_[a-f0-9]{64}$",
      "description": "One-time plaintext machine bearer token. Must be copied immediately; will never be displayed again."
    },
    "description": {
      "type": "string"
    },
    "allowedProjects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowedEnvironments": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rateLimitPerMin": {
      "type": "integer"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "isRevoked": {
      "type": "boolean"
    },
    "lastUsedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}

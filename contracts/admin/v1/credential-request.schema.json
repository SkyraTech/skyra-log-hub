{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.skyra-tech.com/schemas/admin/v1/credential-request.schema.json",
  "title": "CredentialCreateRequestV1",
  "description": "Payload for provisioning or rotating an ingestion machine credential.",
  "type": "object",
  "required": ["description", "allowedProjects", "allowedEnvironments"],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "description": "Human-readable label or purpose for this machine credential."
    },
    "allowedProjects": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Project IDs this credential is authorized to submit logs to."
    },
    "allowedEnvironments": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Environments allowed (e.g. production, staging)."
    },
    "rateLimitPerMin": {
      "type": "integer",
      "minimum": 60,
      "maximum": 60000,
      "default": 600,
      "description": "Maximum requests admitted per minute."
    },
    "expiresInDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365,
      "default": 90,
      "description": "Validity duration in days."
    }
  }
}

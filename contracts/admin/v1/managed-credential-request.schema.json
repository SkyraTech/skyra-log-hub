{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ManagedCredentialCreateRequestV1","type":"object","additionalProperties":false,"required":["description"],
  "properties":{
    "description":{"type":"string","minLength":3,"maxLength":255,"pattern":"^(?!.*skyra_live_[a-fA-F0-9]{64})[^\\u0000-\\u001f\\u007f]+$"},
    "allowedProjects":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"string"},"description":"If provided, the single value must equal the route project ID. No wildcard."},
    "allowedEnvironments":{"type":"array","minItems":1,"maxItems":5,"uniqueItems":true,"items":{"enum":["production","staging","development","test","local"]},"default":["production"]},
    "rateLimitPerMin":{"type":"integer","minimum":60,"maximum":60000,"default":600},
    "expiresInDays":{"type":"integer","minimum":1,"maximum":365,"default":90}
  }
}

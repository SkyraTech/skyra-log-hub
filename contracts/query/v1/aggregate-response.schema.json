{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.skyra-tech.com/schemas/query/v1/aggregate-response.schema.json",
  "title": "SkyraQueryAggregateResponseV1",
  "description": "Response envelope for POST /query/v1/logs/aggregate.",
  "type": "object",
  "required": [
    "aggregations",
    "statistics",
    "scope"
  ],
  "additionalProperties": false,
  "properties": {
    "aggregations": {
      "type": "object",
      "description": "Map of aggregation names to aggregation bucket results.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "date_histogram",
              "terms",
              "cardinality"
            ]
          },
          "buckets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "count"
              ],
              "properties": {
                "key": {
                  "description": "Bucket key for terms aggregations."
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Bucket start for date_histogram."
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of matching events in bucket."
                }
              }
            }
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "description": "Value for single-value aggregations such as cardinality."
          },
          "interval_ms": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "statistics": {
      "type": "object",
      "required": [
        "scanned_bytes",
        "scanned_segments",
        "execution_time_ms",
        "archive_watermark"
      ],
      "additionalProperties": false,
      "properties": {
        "scanned_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "scanned_segments": {
          "type": "integer",
          "minimum": 0
        },
        "execution_time_ms": {
          "type": "number",
          "minimum": 0
        },
        "archive_watermark": {
          "type": "string",
          "format": "date-time"
        },
        "partial_results": {
          "type": "boolean"
        },
        "unavailable_segments": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "tenant_id",
        "searched_projects"
      ],
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string"
        },
        "searched_projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "query_range": {
      "type": "object",
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "const": "UTC"
        }
      }
    }
  }
}

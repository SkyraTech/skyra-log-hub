{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.skyra-tech.com/schemas/query/v1/facets-request.schema.json",
  "title": "SkyraQueryFacetsRequestV1",
  "description": "Request envelope for POST /query/v1/logs/facets.",
  "type": "object",
  "required": ["time_range", "facet_fields"],
  "additionalProperties": false,
  "properties": {
    "time_range": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
        "end": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" }
      }
    },
    "projects": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
      "maxItems": 20
    },
    "environments": {
      "type": "array",
      "items": { "type": "string", "enum": ["production", "staging", "development", "test", "local"] },
      "maxItems": 5
    },
    "facet_fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "enum": ["service.name", "log.level", "event.action", "environment", "error.type"]
      },
      "description": "List of categorical fields to calculate distinct facet values and counts for."
    }
  }
}

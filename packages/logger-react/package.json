{
  "name": "@skyra/logger-react",
  "version": "1.0.0",
  "description": "Production-grade React logging integration, Context Provider, useSkyraLogger hook, and Error Boundary for Skyra LogHub",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/skyra-logger-provider.d.ts",
      "import": "./dist/skyra-logger-provider.js",
      "default": "./dist/skyra-logger-provider.js"
    },
    "./hook": {
      "types": "./dist/use-skyra-logger.d.ts",
      "import": "./dist/use-skyra-logger.js",
      "default": "./dist/use-skyra-logger.js"
    },
    "./error-boundary": {
      "types": "./dist/skyra-error-boundary.d.ts",
      "import": "./dist/skyra-error-boundary.js",
      "default": "./dist/skyra-error-boundary.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('dist-test', { recursive: true, force: true })\"",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/**/*.test.js"
  },
  "keywords": [
    "skyra",
    "react",
    "logging",
    "browser",
    "observability",
    "error-boundary",
    "tracing"
  ],
  "author": "Skyra Tech <hello@skyra-tech.com>",
  "license": "UNLICENSED",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@skyra/logger-browser": "workspace:*",
    "@skyra/logger-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3"
  }
}

{
  "name": "@skyra/logger-angular",
  "version": "1.0.0",
  "description": "Production-grade Angular logging integration and automatic error/router observability for Skyra LogHub",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./error-handler": {
      "types": "./dist/skyra-error-handler.d.ts",
      "import": "./dist/skyra-error-handler.js",
      "default": "./dist/skyra-error-handler.js"
    },
    "./router-tracker": {
      "types": "./dist/skyra-router-tracker.d.ts",
      "import": "./dist/skyra-router-tracker.js",
      "default": "./dist/skyra-router-tracker.js"
    },
    "./http-interceptor": {
      "types": "./dist/skyra-http-interceptor.d.ts",
      "import": "./dist/skyra-http-interceptor.js",
      "default": "./dist/skyra-http-interceptor.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('dist-test', { recursive: true, force: true })\"",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/**/*.test.js"
  },
  "keywords": [
    "skyra",
    "angular",
    "logging",
    "browser",
    "observability",
    "tracing",
    "error-handler"
  ],
  "author": "Skyra Tech <hello@skyra-tech.com>",
  "license": "UNLICENSED",
  "peerDependencies": {
    "@angular/common": ">=16.0.0",
    "@angular/core": ">=16.0.0",
    "@angular/router": ">=16.0.0",
    "rxjs": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/router": {
      "optional": true
    }
  },
  "dependencies": {
    "@skyra/logger-browser": "workspace:*",
    "@skyra/logger-core": "workspace:*"
  },
  "devDependencies": {
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@types/node": "^26.6.5",
    "rxjs": "^7.8.2",
    "typescript": "^5.6.3",
    "zone.js": "^0.15.0"
  }
}

{
  "name": "@skyra/log-shipper",
  "version": "0.1.0",
  "description": "Reliable Standalone JSONL Shipping Agent for Skyra LogHub",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('dist-test', { recursive: true, force: true })\"",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/**/*.test.js",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@skyra/logger-core": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@skyra/ingestion-gateway": "workspace:*",
    "@skyra/logger-browser": "workspace:*",
    "@skyra/logger-nestjs": "workspace:*",
    "@skyra/logger-next": "workspace:*",
    "@skyra/logger-node": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}

# Skyra LogHub Ingestion Gateway Configuration
# Environment Variables (Development Placeholder Example)

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# PostgreSQL Metadata Connection (Placeholder - User will configure manually)
DATABASE_URL="postgresql://skyra_loghub_user:REPLACE_ME@localhost:5432/skyra_loghub_dev"

# Ingestion Limits
MAX_BATCH_SIZE=500
MAX_PAYLOAD_BYTES=5242880
DEFAULT_RATE_LIMIT_PER_MINUTE=600
BURST_RATE_LIMIT_PER_MINUTE=1200

# CORS Allowed Origins for trusted application backend proxies
CORS_ORIGINS="http://localhost:3000,http://localhost:4200"

# Durability Engine Status (Must remain false until LOGHUB-ING-003)
DURABILITY_BACKEND_ENABLED=false

# Graceful Shutdown
SHUTDOWN_TIMEOUT_MS=10000

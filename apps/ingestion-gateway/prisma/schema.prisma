// Prisma Schema for Skyra LogHub Metadata & Operational Catalog
// Task: LOGHUB-ING-002 (Metadata Foundation)
// Reference: docs/ingestion/09-METADATA_MODEL.md

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DECOMMISSIONED
}

enum ProjectStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Registered enterprise tenants
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(64) // e.g. "skyra-internal"
  name      String       @db.VarChar(255)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  projects    Project[]
  credentials IngestionCredential[]
  quotas      ProjectQuota[]

  memberships        TenantMembership[]
  projectMemberships ProjectMembership[]
  roleAssignments    RoleAssignment[]
  invitations        Invitation[]
  savedSearches      SavedSearch[]
  dashboardPreferences DashboardPreference[]
  auditEvents        AdminAuditEvent[]

  @@map("tenants")
}

/// Registered observability projects within a tenant
model Project {
  id        String        @id @db.VarChar(64) // Canonical kebab-case ID, e.g. "skyra-tech"
  tenantId  String        @map("tenant_id") @db.Uuid
  name      String        @db.VarChar(255)
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  savedSearches SavedSearch[]
  dashboardPreferences DashboardPreference[]
  quotas ProjectQuota[]

  memberships       ProjectMembership[]
  roleAssignments   RoleAssignment[]
  ingestionCredentials IngestionCredential[] @relation("CredentialProject")
  usageWindows ProjectUsageWindow[]
  legacyQuotas      ProjectQuota[] @relation("LegacyProjectQuota")
  legacyMemberships ProjectMembership[] @relation("LegacyProjectMembership")
  legacyAssignments RoleAssignment[]    @relation("LegacyRoleAssignment")

  @@unique([tenantId, id], map: "projects_tenant_id_id_key")
  @@index([tenantId, createdAt, id], map: "projects_tenant_created_id_idx")
  @@map("projects")
}

/// Ingestion machine credentials for servers, shippers, and proxies
model IngestionCredential {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  projectId           String? @map("project_id") @db.VarChar(64)
  createdBy           String? @map("created_by") @db.Uuid
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz
  rotatedFromId       String? @unique(map: "ingestion_credentials_replacement_key") @map("rotated_from_id") @db.Uuid
  issuanceRequestId   String? @unique(map: "ingestion_credentials_request_key") @map("issuance_request_id") @db.Uuid
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz
  keyHash             String    @unique @map("key_hash") @db.VarChar(64)
  keyPrefix           String    @map("key_prefix") @db.VarChar(24)
  description         String    @db.VarChar(255)
  allowedProjects     String[]  @map("allowed_projects")
  allowedEnvironments String[]  @map("allowed_environments")
  rateLimitPerMin     Int       @default(600) @map("rate_limit_per_minute")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz
  isRevoked           Boolean   @default(false) @map("is_revoked")
  lastUsedAt          DateTime? @map("last_used_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  project Project? @relation("CredentialProject", fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ingestion_credentials_project_fkey")
  creator User? @relation("CredentialCreator", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "ingestion_credentials_creator_fkey")
  rotatedFrom IngestionCredential? @relation("CredentialReplacement", fields: [tenantId, projectId, rotatedFromId], references: [tenantId, projectId, id], onDelete: Restrict, onUpdate: Restrict, map: "ingestion_credentials_replacement_fkey")
  replacements IngestionCredential[] @relation("CredentialReplacement")
  @@unique([tenantId, projectId, id], map: "ingestion_credentials_tenant_project_id_key")
  @@index([tenantId, projectId, createdAt, id], map: "ingestion_credentials_project_created_id_idx")
  @@index([tenantId])
  @@map("ingestion_credentials")
}

/// Project-specific quotas and ingestion admission budgets
model ProjectQuota {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  projectId       String   @map("project_id") @db.VarChar(64)
  dailyEvents BigInt? @map("daily_events")
  dailyBytes BigInt? @map("daily_bytes")
  enabled Boolean @default(true)
  version BigInt @default(1)
  maxBatchSize    Int      @default(500) @map("max_batch_size")
  maxPayloadBytes Int      @default(5242880) @map("max_payload_bytes") // 5 MiB
  maxEventsPerSec Int      @default(5000) @map("max_events_per_sec")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "project_quotas_tenant_project_fkey")

  legacyProject Project @relation("LegacyProjectQuota", fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId])
  @@map("project_quotas")
}

/// Catalog of finalized immutable archive segments (Source of truth in .manifest.json)
model ArchiveSegment {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.VarChar(64)
  projectId           String   @map("project_id") @db.VarChar(64)
  environment         String   @db.VarChar(32)
  serviceName         String   @map("service_name") @db.VarChar(64)
  date                String   @db.VarChar(10) // YYYY-MM-DD
  segmentFilename     String   @map("segment_filename") @db.VarChar(64)
  recordCount         Int      @map("record_count")
  byteSize            BigInt   @map("byte_size")
  sha256Checksum      String   @map("sha256_checksum") @db.VarChar(64)
  firstEventTimestamp DateTime @map("first_event_timestamp") @db.Timestamptz
  lastEventTimestamp  DateTime @map("last_event_timestamp") @db.Timestamptz
  finalizedAt         DateTime @map("finalized_at") @db.Timestamptz
  writerInstanceId    String   @map("writer_instance_id") @db.VarChar(128)
  journalSegmentId    String   @map("journal_segment_id") @db.VarChar(64)
  journalStartOffset  BigInt   @map("journal_start_offset")
  journalEndOffset    BigInt   @map("journal_end_offset")

  @@unique([tenantId, projectId, environment, serviceName, date, segmentFilename])
  @@index([tenantId, projectId, date])
  @@map("archive_segments")
}

/// Durable deduplication receipts (retained for 7 days)
model DeduplicationReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.VarChar(64)
  projectId      String   @map("project_id") @db.VarChar(64)
  batchId        String   @map("batch_id") @db.VarChar(64)
  contentDigest  String   @map("content_digest") @db.VarChar(71) // sha256:<hex_64>
  journalSegment String   @map("journal_segment") @db.VarChar(64)
  journalOffset  BigInt   @map("journal_offset")
  acceptedCount  Int      @map("accepted_count")
  committedAt    DateTime @default(now()) @map("committed_at") @db.Timestamptz
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  @@unique([tenantId, projectId, batchId])
  @@index([expiresAt])
  @@map("deduplication_receipts")
}

/// Watermark checkpoints for background consumers and compactor workers
model IngestionCheckpoint {
  id             String   @id @db.VarChar(64) // e.g. "archive_writer_primary"
  journalSegment String   @map("journal_segment") @db.VarChar(64)
  byteOffset     BigInt   @map("byte_offset")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("ingestion_checkpoints")
}

// Shared metadata owner: ingestion-gateway. Query service mirrors this schema.
// Expression index uq_role_assignments_scope and audit triggers remain SQL-managed.
enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MembershipStatus {
  PENDING_INVITE
  ACTIVE
  SUSPENDED
  REVOKED
}

model User {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issuer             String              @db.VarChar(255)
  subject            String              @db.VarChar(255)
  email              String              @db.VarChar(255)
  displayName        String              @map("display_name") @db.VarChar(255)
  status             UserStatus          @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @default(now()) @map("updated_at") @db.Timestamptz
  memberships        TenantMembership[]
  projectMemberships ProjectMembership[]
  roleAssignments    RoleAssignment[]
  savedSearches      SavedSearch[]
  dashboardPreferences DashboardPreference[]
  auditEvents        AdminAuditEvent[]

  @@unique([issuer, subject], map: "uq_users_issuer_subject")
  @@index([email], map: "users_email_idx")
  createdCredentials IngestionCredential[] @relation("CredentialCreator")
  @@map("users")
}

model TenantMembership {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_tenant_memberships_tenant")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_tenant_memberships_user")
  roleAssignments RoleAssignment[]

  @@unique([tenantId, userId], map: "uq_tenant_memberships_tenant_user")
  @@index([userId], map: "tenant_memberships_user_id_idx")
  @@index([tenantId, createdAt, id], map: "tenant_memberships_tenant_created_id_idx")
  @@map("tenant_memberships")
}

model ProjectMembership {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  projectId     String           @map("project_id") @db.VarChar(64)
  userId        String           @map("user_id") @db.Uuid
  status        MembershipStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_project_memberships_tenant")
  project       Project          @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade, map: "project_memberships_tenant_project_fkey")
  legacyProject Project          @relation("LegacyProjectMembership", fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_project_memberships_project")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_project_memberships_user")

  @@unique([tenantId, projectId, userId], map: "uq_project_memberships_scope")
  @@index([userId], map: "project_memberships_user_id_idx")
  @@map("project_memberships")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique(map: "roles_name_key") @db.VarChar(64)
  description String           @db.VarChar(255)
  isSystem    Boolean          @default(true) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  assignments RoleAssignment[]
  permissions RolePermission[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique(map: "permissions_code_key") @db.VarChar(64)
  description String           @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_role_permissions_role")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_role_permissions_permission")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleAssignment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  projectId     String?  @map("project_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_role_assignments_tenant")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_role_assignments_user")
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_role_assignments_role")
  membership    TenantMembership @relation(fields: [tenantId,userId], references: [tenantId,userId], onDelete: Restrict, onUpdate: Restrict, map: "role_assignments_membership_fkey")
  project       Project? @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade, map: "role_assignments_tenant_project_fkey")
  legacyProject Project? @relation("LegacyRoleAssignment", fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_role_assignments_project")

  @@index([tenantId, userId], map: "role_assignments_tenant_user_idx")
  @@map("role_assignments")
}

model Invitation {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  email           String           @db.VarChar(255)
  roleId          String           @map("role_id") @db.Uuid
  projectIds      String[]         @default([]) @map("project_ids")
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  tokenHash       String           @unique(map: "invitations_token_hash_key") @map("token_hash") @db.VarChar(64)
  status          MembershipStatus @default(PENDING_INVITE)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_invitations_tenant")
  role            Role             @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_invitations_role")

  @@index([tenantId, email], map: "invitations_tenant_id_email_idx")
  @@map("invitations")
}

model AdminAuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorEmail  String   @map("actor_email") @db.VarChar(255)
  action      String   @db.VarChar(64)
  targetType  String   @map("target_type") @db.VarChar(64)
  targetId    String   @map("target_id") @db.VarChar(64)
  details     Json     @default("{}") @db.JsonB
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_admin_audit_events_tenant")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_admin_audit_events_actor")

  @@index([tenantId, createdAt(sort: Desc)], map: "admin_audit_events_tenant_id_created_at_idx")
  @@index([action], map: "admin_audit_events_action_idx")
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)], map: "admin_audit_tenant_time_id_idx")
  @@index([tenantId, action, createdAt(sort: Desc), id(sort: Desc)], map: "admin_audit_tenant_action_time_id_idx")
  @@index([tenantId, actorUserId, createdAt(sort: Desc), id(sort: Desc)], map: "admin_audit_tenant_actor_time_id_idx")
  @@index([tenantId, targetType, targetId, createdAt(sort: Desc), id(sort: Desc)], map: "admin_audit_tenant_resource_time_id_idx")
  @@map("admin_audit_events")
}

/// Stable journal ownership namespace. Never garbage collect pending accounting evidence.
model QuotaJournal {
  id String @id @db.Uuid
  pathHash String @unique @map("path_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  admissions QuotaAdmission[]
  @@map("quota_journals")
}
model ProjectUsageWindow {
  tenantId String @map("tenant_id") @db.Uuid
  projectId String @map("project_id") @db.VarChar(64)
  period DateTime @db.Date
  acceptedEvents BigInt @default(0) @map("accepted_events")
  acceptedBytes BigInt @default(0) @map("accepted_bytes")
  reservedEvents BigInt @default(0) @map("reserved_events")
  reservedBytes BigInt @default(0) @map("reserved_bytes")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  project Project @relation(fields:[tenantId,projectId],references:[tenantId,id],onDelete:Restrict,onUpdate:Restrict,map:"usage_project_fkey")
  admissions QuotaAdmission[]
  @@id([tenantId,projectId,period])
  @@map("project_usage_windows")
}
model QuotaAdmission {
  tenantId String @map("tenant_id") @db.Uuid
  projectId String @map("project_id") @db.VarChar(64)
  batchId String @map("batch_id") @db.VarChar(64)
  digest String @db.VarChar(71)
  events Int
  bytes BigInt
  period DateTime @db.Date
  journalId String @map("journal_id") @db.Uuid
  state String @db.VarChar(16)
  receiptId String @map("receipt_id") @db.Uuid
  receipt Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  window ProjectUsageWindow @relation(fields:[tenantId,projectId,period],references:[tenantId,projectId,period],onDelete:Restrict,onUpdate:NoAction,map:"admission_window_fkey")
  journal QuotaJournal @relation(fields:[journalId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  @@id([tenantId,projectId,batchId])
  @@map("quota_admissions")
}

// DEV-013: encrypted BFF records; runtime access is isolated from ingestion.
model BffSessionRecord {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenDigest String @unique @map("token_digest") @db.Char(64)
  encryptedData String @map("encrypted_data")
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  lastActivityAt DateTime @default(dbgenerated("clock_timestamp()")) @map("last_activity_at") @db.Timestamptz
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz
  idleExpiresAt DateTime @map("idle_expires_at") @db.Timestamptz
  version Int @default(1)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  @@map("bff_sessions")
}
model BffLoginTransaction {
  stateDigest String @id @map("state_digest") @db.Char(64)
  encryptedData String @map("encrypted_data")
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  @@map("bff_login_transactions")
}

// DEV-015: personal/project saved configurations, never log/archive records.
model SavedSearch {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  projectId String @map("project_id") @db.VarChar(64)
  ownerId String @map("owner_id") @db.Uuid
  name String @db.VarChar(120)
  description String @default("") @db.VarChar(500)
  visibility String @default("PRIVATE") @db.VarChar(7)
  filters Json
  version BigInt @default(1)
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  project Project @relation(fields:[tenantId,projectId],references:[tenantId,id],onDelete:Restrict,map:"saved_searches_project_scope_fk")
  owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
  @@unique([tenantId,projectId,ownerId,name],map:"saved_searches_owner_name_key")
  @@index([tenantId,projectId,ownerId,id],map:"saved_searches_owner_list_idx")
  @@map("saved_searches")
}

// DEV-016: user-owned Analytics presentation settings; no stored authority or search definition.
model DashboardPreference {
  tenantId String @map("tenant_id") @db.Uuid
  projectId String @map("project_id") @db.VarChar(64)
  ownerId String @map("owner_id") @db.Uuid
  settings Json
  version BigInt @default(1)
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  project Project @relation(fields:[tenantId,projectId],references:[tenantId,id],onDelete:Restrict,map:"dashboard_preferences_project_scope_fk")
  owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
  @@id([tenantId,projectId,ownerId])
  @@map("dashboard_preferences")
}
